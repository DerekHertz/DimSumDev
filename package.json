{
  "name": "dim-sum-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "board": "apps/board/board.mjs",
    "den": "scripts/den-cli.mjs"
  },
  "scripts": {
    "pretest": "npm run check:bom",
    "test": "node scripts/test-lock.mjs node scripts/test-split.mjs all",
    "codex:sync": "node scripts/codex-sync.mjs",
    "test:browser": "node scripts/test-split.mjs browser",
    "test:rest": "node scripts/test-split.mjs rest",
    "test:path": "node scripts/test-path.mjs",
    "merge:green": "node scripts/merge-when-green.mjs",
    "dev": "node apps/ci-cd/dev-server.mjs",
    "smoke": "node apps/ci-cd/smoke.mjs",
    "smoke:ui": "node apps/ci-cd/smoke-ui.mjs",
    "verify:ui": "node apps/ci-cd/verify-ui.mjs",
    "smoke:live": "node apps/bridge/agents/conformance.mjs --spike Live",
    "risk-check": "node scripts/risk-check.mjs",
    "kit:install": "node scripts/den-cli.mjs install",
    "pr-map": "node scripts/pr-map.mjs",
    "test-guard": "node scripts/test-guard.mjs",
    "check:bom": "node scripts/bom-check.mjs",
    "board": "node apps/board/board.mjs",
    "queue": "node scripts/queue.mjs",
    "spend": "node scripts/spend.mjs",
    "apply-gated": "node scripts/apply-gated.mjs",
    "queue-admin": "node scripts/queue-admin.mjs",
    "next-session": "node scripts/next-session.mjs",
    "session-check": "node scripts/session-check.mjs",
    "bridge": "node apps/bridge/server.mjs",
    "den:project": "node scripts/den-project.mjs",
    "den:install": "node apps/bridge/service/den-service.mjs install",
    "den:update": "node apps/bridge/service/den-service.mjs update",
    "den:account": "node scripts/den-account.mjs",
    "den:link": "node apps/bridge/service/den-service.mjs link",
    "ui": "npm run ui:build && npm run bridge",
    "ui:build": "vite build --config apps/ui/vite.config.mjs --configLoader native",
    "ui:dev": "vite --config apps/ui/vite.config.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.170.0"
  }
}
