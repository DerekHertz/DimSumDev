    { "id": "router", "paths": ["apps/router/**"] },
    { "id": "board", "paths": ["apps/board/**", "packages/board-refs/**"] },
    { "id": "shared", "paths": ["apps/shared/**"] },
    { "id": "scripts", "paths": ["scripts/*", "scripts/jev-evals/**"] },
