{
  "docker": [
    "run",
    "--rm",
    "-i",
    "--name",
    "den-agent-fd73c5b5",
    "--network",
    "den-agents",
    "--user",
    "0:0",
    "--cap-drop",
    "ALL",
    "--security-opt",
    "no-new-privileges",
    "--memory",
    "2048m",
    "--memory-swap",
    "2048m",
    "--cpus",
    "1",
    "--pids-limit",
    "256",
    "-e",
    "HOME=/root",
    "-e",
    "ANTHROPIC_BASE_URL=http://den-proxy:8080",
    "-e",
    "ANTHROPIC_API_KEY=sk-ant-dummy-not-a-key",
    "-e",
    "HTTPS_PROXY=http://den-proxy:8080",
    "-e",
    "NO_PROXY=den-proxy",
    "-e",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1",
    "-v",
    "/tmp/den-ctr-kL6FTs/main/.claude/worktrees/probe:/tmp/den-ctr-kL6FTs/main/.claude/worktrees/probe:rw",
    "-v",
    "/tmp/den-ctr-kL6FTs/main/.git:/tmp/den-ctr-kL6FTs/main/.git:ro",
    "-v",
    "/tmp/den-ctr-kL6FTs/main/.git/worktrees/probe:/tmp/den-ctr-kL6FTs/main/.git/worktrees/probe:rw",
    "-v",
    "/tmp/den-ctr-kL6FTs/main/.git/objects:/tmp/den-ctr-kL6FTs/main/.git/objects:rw",
