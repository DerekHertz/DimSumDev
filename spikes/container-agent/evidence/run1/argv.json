    "/tmp/den-ctr-kL6FTs/main/.git/refs/heads/den:/tmp/den-ctr-kL6FTs/main/.git/refs/heads/den:rw",
    "-v",
    "/tmp/den-ctr-kL6FTs/main/.git/logs:/tmp/den-ctr-kL6FTs/main/.git/logs:rw",
    "-v",
    "/tmp/den-ctr-kL6FTs/ro:/tmp/den-ctr-kL6FTs/ro:ro",
