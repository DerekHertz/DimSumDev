    "fd73c5b5-c49a-4d1b-a762-5643deee038e",
    "--agent",
    "scout",
    "--model",
    "haiku",
    "--setting-sources",
    "project,local",
    "--strict-mcp-config",
    "--settings",
    "{\"permissions\":{\"allow\":[\"Bash\",\"Read\"],\"deny\":[]}}"
