{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/usage.mjs)",
      "Bash(git fetch:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git merge-tree:*)",
      "Bash(git worktree list)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(npm test:*)",
      "Bash(npm run -s board:*)",
      "Bash(npm run board:*)",
      "Bash(npm run -s risk-check)",
      "Bash(node scripts/agent-start.mjs:*)",
      "Bash(node scripts/cell-start.mjs:*)",
      "Bash(node scripts/context.mjs)"
    ],
    "deny": [
      "mcp__claude-in-chrome",
      "mcp__computer-use",
      "mcp__scheduled-tasks",
      "mcp__mcp-registry",
      "mcp__plugin_design_asana",
      "mcp__plugin_design_atlassian",
      "mcp__plugin_design_figma",
      "mcp__plugin_design_intercom",
      "mcp__plugin_design_linear",
      "mcp__plugin_design_notion",
      "mcp__plugin_design_slack",
      "mcp__plugin_engineering_datadog",
      "mcp__plugin_engineering_github",
      "mcp__plugin_engineering_pagerduty",
      "Bash(git worktree remove --force:*)",
      "Bash(git worktree remove -f:*)",
      "Bash(npm run queue-admin:*)",
      "Bash(node scripts/queue-admin.mjs:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/scripts/statusline.mjs\""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/session-start.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/context-budget.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/bash-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/notify.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/notify.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "sleep-guard@dimsumden-mods": true,
    "test-run-guard@dimsumden-mods": true,
    "north-star@dimsumden-mods": true,
    "queue@dimsumden-mods": true
  }
}
