# The den's bridge as a systemd user service (ADR 0026 decision 4). `npm run den:install` fills the @...@ marks from this
# machine and writes the result to ~/.config/systemd/user/den.service; nothing else writes it, and no agent or bridge route may.
# It runs the launcher den:install copied outside every release (den-mvp/77), which starts the release bridge/current names.
[Unit]
Description=Dim Sum Dev bridge

[Service]
Type=simple
Slice=den.slice
WorkingDirectory=@CHECKOUT@
ExecStart=@NODE@ @STATE@/launcher/den-launcher.mjs
Environment=PORT=4317
Environment=DEN_STATE_DIR=@STATE@
Environment="PATH=@PATH@"
Restart=on-failure
SuccessExitStatus=143
RestartSec=2
# Inherited by every agent and check the bridge starts (systemd-run --scope runs in the caller). bwrap here needs no setuid bit.
# No ProtectSystem or ProtectHome: in a user unit they bring a user namespace, and the bridge writes in the checkout and its worktrees.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
